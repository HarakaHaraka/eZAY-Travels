# ── database ──
DATABASE_URL=postgresql://user:pass@localhost:5432/ezay

# ── Duffel (TEST) ──
DUFFEL_API_KEY=duffel_test_xxx

# ── Stripe (TEST) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_MODE=stripe_direct          # stripe_direct | collect_and_remit

# ── pricing ──
MARKUP_SHORT_HAUL_PCT=0.05
MARKUP_LONG_HAUL_PCT=0.08
MARKUP_MIN_PER_TICKET_MINOR=1500    # £15.00 floor, in pence
MARKUP_PACKAGE_PCT=0.10

# ── accreditation — SHIP THESE BLANK ──
# Blank = no protection claim rendered anywhere, and flight checkout disabled.
ATOL_HOLDER_NAME=
ATOL_NUMBER=
ATOL_STATEMENT=
ATOL_SCOPE=                          # csv: flight_only,package

# ── email ──
# Microsoft 365 business account (recommended once the domain is live):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hello@ezaytravels.co.uk
SMTP_PASS=
NOTIFY_EMAIL=hello@ezaytravels.co.uk
# or a transactional provider instead:
RESEND_API_KEY=

# ── contact ──
WHATSAPP_NUMBER=447000000000
COMPANY_PHONE=+440000000000

# ── admin ──
ADMIN_PASSWORD=
