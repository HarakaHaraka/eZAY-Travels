# ── database ──
DATABASE_URL=postgresql://user:pass@localhost:5432/ezay

# ── Duffel (TEST) ──
DUFFEL_API_KEY=duffel_test_xxx

# ── Stripe (TEST) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_MODE=stripe_direct          # stripe_direct | collect_and_remit

# ── pricing ──
MARKUP_SHORT_HAUL_PCT=0.05
MARKUP_LONG_HAUL_PCT=0.08
MARKUP_MIN_PER_TICKET_MINOR=2000    # £20.00 floor per ticket, in pence
MARKUP_PACKAGE_PCT=0.10

# ── accreditation — SHIP THESE BLANK ──
# Blank = no protection claim rendered anywhere, and flight checkout disabled.
ATOL_HOLDER_NAME=
ATOL_NUMBER=
ATOL_STATEMENT=
ATOL_SCOPE=                          # csv: flight_only,package
# Flight-only agent mode: true = sell instantly-issued flight-only tickets as a
# disclosed agent for the airline, with NO protection claim shown. Packages stay off.
FLIGHT_ONLY_AGENT_MODE=false
# ICO data-protection registration reference, printed in the footer once issued.
ICO_REFERENCE=

# ── email ──
# Microsoft 365 business account (recommended once the domain is live):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Account that logs in to Microsoft 365 (needs Send As on the from-address)
SMTP_USER=admin@harakatransport.co.uk
SMTP_PASS=
# Address customers see; must be a mailbox/alias SMTP_USER may send as
EMAIL_FROM=manager@ezaytravels.co.uk
NOTIFY_EMAIL=manager@ezaytravels.co.uk
# or a transactional provider instead:
RESEND_API_KEY=
# Microsoft 365 via Graph API (preferred — Microsoft has retired SMTP password login).
# Entra admin centre > App registrations > New registration; API permissions >
# Microsoft Graph > Application > Mail.Send > Grant admin consent;
# Certificates & secrets > New client secret.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ── contact ──
WHATSAPP_NUMBER=447849549140
COMPANY_PHONE=+44 7849 549140
COMPANY_EMAIL=manager@ezaytravels.co.uk

# ── admin ──
ADMIN_PASSWORD=
